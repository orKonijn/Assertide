PORT=4010
ENABLE_LAB=false
# Use PostgreSQL for deployed services. Without it, development uses embedded storage.
DATABASE_URL=
LOCAL_DATABASE_PATH=.local-db
# Generate unique values before enabling the lab; never use production credentials.
LAB_PASSWORD=
LAB_SIGNING_KEY=
# Local npm start generates development identity configuration automatically.
# For deployment, provide a private OIDC registration and separate report origin.
APP_ORIGIN=http://127.0.0.1:4200
REPORT_ORIGIN=http://localhost:4012
REPORT_PORT=4012
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SECRET_ENCRYPTION_KEY=
ORGANIZATION_TIME_ZONE=UTC
LOCAL_IDENTITY=false
LOCAL_RUNNER=false
LOCAL_SANDBOX=false
# Separate supervisors: execution or report. Execution requires OCI and Redis.
WORKER_ROLE=
WORKER_RUNTIME=oci
OCI_WORKER_IMAGE=
REDIS_URL=
# Private object storage. Credentials can also come from the platform identity.
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_PROJECT_RUNS=2
MAX_ORGANIZATION_RUNS=4
MAX_ORGANIZATION_WORKERS=8

# Production adapters (Vault Transit uses a derived key; never set a root token).
SECRET_BACKEND=local
VAULT_ADDR=
VAULT_NAMESPACE=
VAULT_ROLE=assertide
VAULT_AUTH_MOUNT=kubernetes
VAULT_JWT_FILE=/var/run/secrets/vault/token
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=assertide
# WORKER_RUNTIME may be kubernetes; OCI_WORKER_IMAGE must then be repository@sha256:...
KUBERNETES_WORKER_NAMESPACE=assertide-workers

# Container networking and internal observability; keep metrics off public ingress.
HOST=127.0.0.1
REPORT_HOST=127.0.0.1
WORKER_HEALTH_PORT=
METRICS_ENABLED=false
BACKUP_S3_BUCKET=

# Durable shared source snapshots for production API/execution supervisors.
# SOURCE_ROOT=/var/lib/assertide/sources
