{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "*.ts",
    "tests/**/*.ts",
    "platform/**/*.ts",
    "practice/**/*.ts",
    "ui/**/*.ts",
    "checks/**/*.ts"
  ]
}
