{
  "name": "assertide-automation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "list": "playwright test --list",
    "test:platform": "playwright test --config platform.config.ts",
    "test:ui": "playwright test --project chromium --project firefox --project webkit",
    "test:architecture": "node checks/architecture.mjs",
    "test:reporting": "node checks/reporting.mjs",
    "report:platform": "node checks/report.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "allure": "3.22.1",
    "allure-js-commons": "3.14.0",
    "allure-playwright": "3.14.0",
    "typescript": "6.0.2",
    "zod": "^4.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
